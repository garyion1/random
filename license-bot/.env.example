# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional: set this to your server's ID while developing so slash commands
# sync instantly (global sync can take up to an hour to propagate). Remove
# it once you're ready for the bot to work in any server it's in.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run admin commands (/genkey,
# /revoke, /unbind, /lookup).
ADMIN_USER_IDS=

# Alternative to ADMIN_USER_IDS: a role ID whose members are all admins.
ADMIN_ROLE_ID=

# Shared secret the Minecraft mod must send in the X-Api-Secret header.
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
API_SHARED_SECRET=

# Port the /validate HTTP API listens on internally (put a reverse proxy
# with TLS in front of this — see README.md).
HTTP_PORT=8000

# How many mismatched-account attempts on one key before it auto-revokes.
MAX_MISMATCH_ATTEMPTS=5
